<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.targetcore</groupId>
  <artifactId>targetcore-java</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <description>Java Panama FFI bindings for the TargetCore native library</description>

  <properties>
    <!-- 23, RAISED FROM 22 ON 2026-08-21, and it is a supported-JDK change
         rather than a tidy-up. jextract 25 emits SymbolLookup.findOrThrow(),
         which arrived in JDK 23; the generated file committed before this used
         find(...).orElseThrow(), which is the JDK 22 spelling of the same
         thing and came out of an older jextract. So the floor is set by the
         tool that writes the bindings, not by anything this project needs.

         The alternative was to rewrite 93 call sites of GENERATED code back to
         the 22 idiom after every regeneration. That was rejected: a committed
         artifact that no longer matches what its generator emits is a manual
         step nobody remembers, and it would regress silently the next time
         somebody follows README Step 3. -->
    <maven.compiler.release>23</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Directory holding TargetCore.dll (and the Msgcore.dll it imports).
         The native sources live in the TargetCore repository, not this one, so
         this points into a checkout of it; override per site:
             mvn test -Dtargetcore.lib.dir=D:\path\to\TargetCore\out\x64\Release
         It used to default to ../native/build, back when this tree carried its
         own copy of the C wrapper. That copy was deleted on 2026-08-14. -->
    <targetcore.lib.dir>${project.basedir}/../../../MSCS/TargetCore/out/x64/Release</targetcore.lib.dir>
  </properties>

  <build>
    <plugins>

      <!-- Compile with enable-preview if needed; at minimum release 23 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Kept in step with maven.compiler.release above. It is spelled out
               here as well as there because this explicit element WINS over the
               property, which is how the 2026-08-21 bump to 23 appeared to do
               nothing: the property moved, this did not, and the build went on
               failing on findOrThrow with the floor apparently already raised. -->
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <!-- Pass enable-native-access for tests.
         NOTE java.library.path below no longer locates the DLL: jextract 25's
         output uses SymbolLookup.libraryLookup, which goes through the OS loader
         search (exe dir, System32, PATH) and never consults it. run_all.ps1 sets
         PATH instead. The property is kept because it costs nothing and a future
         hand-written loader would want it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <!-- Adjust to the directory that holds TargetCore.dll -->
            <java.library.path>${targetcore.lib.dir}</java.library.path>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Executable jar with SmokeTest as main class -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.targetcore.SmokeTest</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
